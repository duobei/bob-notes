---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Noto+Sans+SC:wght@300;400;500;700&family=Crimson+Pro:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
  </head>

  <body>
    <div class="bg-pattern"></div>
    <header class="site-header">
      <nav>
        <a href={import.meta.env.BASE_URL} class="logo">
          <span class="logo-icon">✦</span>
          <span class="logo-text">星河</span>
        </a>
        <div class="nav-links">
          <a href={import.meta.env.BASE_URL}>首页</a>
          <a href={`${import.meta.env.BASE_URL}/about`}>关于</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-content">
        <p>✦ 星河 · 探索与思考</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #faf8f5;
    --color-bg-secondary: #f5f2eb;
    --color-text: #3d3630;
    --color-text-light: #7a726a;
    --color-accent: #c9a86c;
    --color-accent-hover: #b8956a;
    --color-border: #e8e4dd;
    --color-card-bg: #ffffff;
    --shadow-soft: 0 2px 12px rgba(61, 54, 48, 0.06);
    --shadow-hover: 0 8px 24px rgba(61, 54, 48, 0.1);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: 'Noto Sans SC', 'Crimson Pro', serif;
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.7;
  }

  body {
    min-height: 100vh;
    position: relative;
  }

  .bg-pattern {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      radial-gradient(circle at 20% 80%, rgba(201, 168, 108, 0.03) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(201, 168, 108, 0.03) 0%, transparent 50%),
      radial-gradient(circle at 50% 50%, rgba(201, 168, 108, 0.02) 0%, transparent 70%);
    pointer-events: none;
    z-index: -1;
  }

  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    background: rgba(250, 248, 245, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    z-index: 100;
  }

  .site-header nav {
    max-width: 800px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-text);
    font-weight: 500;
  }

  .logo-icon {
    font-size: 1.25rem;
    color: var(--color-accent);
    transition: transform 0.3s ease;
  }

  .logo:hover .logo-icon {
    transform: rotate(20deg);
  }

  .logo-text {
    font-family: 'DM Serif Display', serif;
    font-size: 1.25rem;
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--color-text-light);
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--color-accent);
  }

  /* Main */
  main {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  /* Footer */
  footer {
    text-align: center;
    padding: 2rem;
    color: var(--color-text-light);
    font-size: 0.85rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-content p {
    font-family: 'DM Serif Display', serif;
  }

  /* Article */
  article {
    background: var(--color-card-bg);
    border-radius: 12px;
    padding: 2.5rem;
    box-shadow: var(--shadow-soft);
  }

  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-header .date {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--color-accent);
    font-weight: 500;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .post-header h1 {
    font-family: 'DM Serif Display', serif;
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .content {
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .content h2 {
    font-family: 'DM Serif Display', serif;
    font-size: 1.4rem;
    font-weight: 400;
    margin: 2rem 0 1rem;
    color: var(--color-text);
  }

  .content h3 {
    font-size: 1.15rem;
    font-weight: 500;
    margin: 1.5rem 0 0.75rem;
  }

  .content p {
    margin-bottom: 1rem;
  }

  .content a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .content a:hover {
    border-bottom-color: var(--color-accent);
  }

  .content code {
    background: var(--color-bg-secondary);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: 'SF Mono', Monaco, monospace;
  }

  .content pre {
    background: var(--color-bg-secondary);
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1rem 0;
  }

  .content pre code {
    background: none;
    padding: 0;
  }

  .content ul, .content ol {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }

  .content li {
    margin: 0.5rem 0;
  }

  .content blockquote {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--color-text-light);
  }

  .content img {
    max-width: 100%;
    border-radius: 8px;
    margin: 1rem 0;
  }

  /* Home - Post Cards */
  .post-card {
    background: var(--color-card-bg);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1rem;
    box-shadow: var(--shadow-soft);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
    display: block;
  }

  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-hover);
  }

  .post-card .date {
    font-size: 0.8rem;
    color: var(--color-accent);
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .post-card h2 {
    font-family: 'DM Serif Display', serif;
    font-size: 1.25rem;
    font-weight: 400;
    margin: 0.5rem 0;
    color: var(--color-text);
  }

  .post-card .description {
    font-size: 0.9rem;
    color: var(--color-text-light);
    line-height: 1.6;
  }

  /* Hero Section */
  .hero {
    text-align: center;
    padding: 3rem 0 4rem;
  }

  .hero h1 {
    font-family: 'DM Serif Display', serif;
    font-size: 2.5rem;
    font-weight: 400;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .hero p {
    color: var(--color-text-light);
    font-size: 1.1rem;
  }

  /* About Page */
  .about-content {
    font-size: 1.05rem;
  }

  .about-content h2 {
    font-family: 'DM Serif Display', serif;
    font-size: 1.5rem;
    font-weight: 400;
    margin: 2.5rem 0 1rem;
  }

  .about-content p {
    margin-bottom: 1rem;
  }

  /* Scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: var(--color-bg);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--color-border);
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--color-text-light);
  }

  /* Responsive */
  @media (max-width: 600px) {
    .post-header h1 {
      font-size: 1.6rem;
    }
    
    article {
      padding: 1.5rem;
    }
    
    .hero h1 {
      font-size: 2rem;
    }
  }
</style>
