---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&family=ZCOOL+XiaoWei&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a href={import.meta.env.BASE_URL} class="site-title">📝 每日记录</a>
        <div class="nav-links">
          <a href={import.meta.env.BASE_URL}>首页</a>
          <a href={`${import.meta.env.BASE_URL}/about`}>关于</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>© 2026 Bob's Exploration Blog</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #faf8f5;
    --color-text: #2c2c2c;
    --color-muted: #6b6b6b;
    --color-accent: #8b4513;
    --color-border: #e8e4df;
    --font-serif: 'Noto Serif SC', serif;
    --font-hand: 'ZCOOL XiaoWei', serif;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-serif);
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.8;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .site-header {
    padding: 1.5rem 2rem;
    border-bottom: 1px solid var(--color-border);
    background: #fff;
  }

  .site-header nav {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .site-title {
    font-family: var(--font-hand);
    font-size: 1.5rem;
    text-decoration: none;
    color: var(--color-text);
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--color-muted);
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--color-accent);
  }

  main {
    flex: 1;
    max-width: 800px;
    width: 100%;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  footer {
    padding: 2rem;
    text-align: center;
    color: var(--color-muted);
    font-size: 0.875rem;
    border-top: 1px solid var(--color-border);
  }
</style>
