    color: var(--color-text-light);
    font-size: 0.875rem;
  }

  h1 {
    margin-top: 0.5rem;
    font-size: 2rem;
  }

  .content {
    line-height: 1.8;
  }

  h2 {
    margin-top: 2rem;
    font-size: 1.5rem;
  }

  h3 {
    margin-top: 1.5rem;
    font-size: 1.25rem;
  }

  blockquote {
    border-left: 4px solid var(--color-primary);
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--color-text-light);
  }

  ul, ol {
    padding-left: 1.5rem;
    margin: 1rem 0;
  }

  li {
    margin: 0.5rem 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
  }

  th, td {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }

  th {
    font-weight: 600;
    color: var(--color-text);
  }

  td {
    color: var(--color-text-light);
  }

  hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }
</style>
